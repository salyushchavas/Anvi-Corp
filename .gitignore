# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns are unanchored so they apply at root AND nested (e.g. apps/web/node_modules).

# dependencies
node_modules
.pnp
.pnp.js
.yarn/install-state.gz

# testing
coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# `.env` is where real credentials land once someone fills one in, so it is
# ignored outright — the previous `.env*.local` pattern did NOT cover a
# plain `.env` and would have let one be committed. `.env.example` is the
# committed template and is explicitly re-included.
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Runtime upload storage. When S3 is disabled (the default for local
# development) the backend writes uploaded documents, resumes and generated
# PDFs here. These are real user files — never commit them.
uploads/

# Editor / tooling local settings
.vscode/
.claude/
