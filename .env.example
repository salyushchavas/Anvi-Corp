# ─────────────────────────────────────────────────────────────────────
# Anvi Careers — local development settings
#
# Copy this file to `.env` and you're done. The defaults below run the
# whole app locally; you do NOT need to change anything.
#
#   Mac / Linux:  cp .env.example .env
#   Windows:      copy .env.example .env
#
# ⚠️ FOR LOCAL DEVELOPMENT ONLY.
# The keys and passwords here are throwaway values committed on purpose so
# the stack starts with one command. They are not used by any real
# environment. Never reuse them for a deployed site — generate fresh ones
# (instructions at the bottom of this file).
#
# `.env` itself is gitignored, so anything you put there stays local.
# ─────────────────────────────────────────────────────────────────────


# ── Database ─────────────────────────────────────────────────────────
# Docker creates this Postgres for you. Nothing to install.
POSTGRES_DB=anvi
POSTGRES_USER=anvi
POSTGRES_PASSWORD=anvi_local_dev


# ── Security keys (required — the app won't start without them) ──────
# Both are dev-only throwaways. The app validates their shape at startup:
# JWT_SECRET must be 32+ bytes, PII_ENCRYPTION_KEY must be base64 that
# decodes to exactly 32 bytes (AES-256).
JWT_SECRET=Dau72mhqfGC5i3tj8lDdXpo+yZQgKaJoLxByxIJz+lXnDTB65KN/Zf5mvFdMxKYX
PII_ENCRYPTION_KEY=jbqlxWUfKapsI5fPhn/vNTR41APQ9go4ctMSbj8+z3w=


# ── Test login accounts (DEV ONLY) ───────────────────────────────────
# These seeders create the sign-in accounts listed in the README. They are
# off by default in the application and only switch on because this file
# says so — a real deployment leaves them unset.
SEED_ROLE_ACCOUNTS=true
SEED_TEST_INTERNS=true

# The super-admin account. Password is yours to choose; this is the
# default the README documents.
ADMIN_EMAIL=admin@anvicorp.com
ADMIN_PASSWORD=Admin@Local2026


# ── Ports (change only if something else is already using these) ─────
FRONTEND_PORT=3000
BACKEND_PORT=8080

# Where the browser finds the backend. Must be the address YOUR BROWSER
# can reach, which is localhost — not the internal Docker name. If you
# change BACKEND_PORT above, change the port here to match.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Which origins the backend accepts browser requests from.
CORS_ORIGINS=http://localhost:3000


# ─────────────────────────────────────────────────────────────────────
# OPTIONAL — external services
#
# Everything below is OFF and BLANK on purpose. You do not need any of it
# to run the app, log in, or use the offer/document features. Leave this
# whole section exactly as it is unless you are specifically testing one
# of these integrations.
# ─────────────────────────────────────────────────────────────────────

# ── File storage (S3) ────────────────────────────────────────────────
# Disabled → uploaded documents, resumes and generated offer PDFs are
# written to a local Docker volume instead. The document and offer-letter
# features work fully this way; nothing is lost by leaving it off.
# Set AWS_S3_ENABLED=true and fill in all four values to use a real bucket.
AWS_S3_ENABLED=false
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=

# ── Email (SMTP) ─────────────────────────────────────────────────────
# Blank → the app skips sending and logs instead. Notifications still
# appear inside the app; they just aren't emailed anywhere.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Zoom (interview scheduling) ──────────────────────────────────────
# Disabled → scheduling screens load; creating an actual Zoom meeting is
# the only thing that won't work.
ZOOM_ENABLED=false
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=


# ─────────────────────────────────────────────────────────────────────
# Generating your own keys (only needed for a real deployment)
#
#   JWT_SECRET           openssl rand -base64 48
#   PII_ENCRYPTION_KEY   openssl rand -base64 32
#
# ⚠️ PII_ENCRYPTION_KEY decrypts stored personal data. If it is ever
# changed or lost on an environment that has real data, that data becomes
# unreadable. Generate it once per environment and keep it safe.
# ─────────────────────────────────────────────────────────────────────
