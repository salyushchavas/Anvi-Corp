# Contact form (Resend)
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Where contact-form submissions should land
MAIL_TO=info@anvicorp.com

# "From" sender. Until anvicorp.com is verified in Resend (DNS records),
# use Resend's onboarding sender for the Vercel preview:
#   MAIL_FROM=Anvi Corp Website <onboarding@resend.dev>
# After verifying the domain in Resend, switch to:
#   MAIL_FROM=Anvi Corp Website <noreply@anvicorp.com>
MAIL_FROM=Anvi Corp Website <onboarding@resend.dev>
