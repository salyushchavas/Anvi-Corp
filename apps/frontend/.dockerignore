# Installed fresh inside the image — copying the host's copy is slow and can
# carry platform-specific binaries that break on Alpine.
node_modules/

# Build output — regenerated in the image.
.next/
out/

# Editor / OS noise
.idea/
.vscode/
.DS_Store

# Never copy real secrets into a build context.
.env
.env.*
!.env.example

# Not needed at build time.
npm-debug.log*
*.tsbuildinfo
